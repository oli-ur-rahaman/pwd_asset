  min-width: 42px;
  height: 42px;
  padding: 0;
  border-radius: 10px;
  font-size: 18px;
  line-height: 1;
}
.icon-action-button { background: var(--theme-primary); }
.icon-delete-button { background: var(--theme-danger); }
.hidden { display: none !important; }
.container { width: 100%; padding: 16px 18px; max-width: none; margin: 0; }
.nav { background: linear-gradient(90deg, var(--theme-nav-start), var(--theme-nav-end)); color: #fff; padding: 16px 24px; display: flex; gap: 16px; justify-content: space-between; align-items: center; }
