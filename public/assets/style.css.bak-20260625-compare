}
body.theme-slate { --theme-primary: #334155; --theme-primary-dark: #1e293b; --theme-primary-soft: #dbe5f0; --theme-primary-soft-2: #edf2f7; --theme-primary-soft-3: #e8eef5; --theme-secondary: #475569; --theme-nav-start: #334155; --theme-nav-end: #475569; }
