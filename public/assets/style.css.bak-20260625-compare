.hero-subtitle { margin: 0; font-size: 15px; line-height: 1.45; color: #627588; }
.hero-actions { margin-left: auto; display: flex; gap: 26px; align-items: center; justify-content: flex-end; flex-wrap: nowrap; text-align: left; }
