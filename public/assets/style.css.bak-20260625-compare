body.theme-teal { --theme-primary: #0f766e; --theme-primary-dark: #134e4a; --theme-primary-soft: #d5f1ee; --theme-primary-soft-2: #ebfbf8; --theme-primary-soft-3: #e3f7f3; --theme-accent-soft: #edfafe; --theme-secondary: #0f766e; --theme-nav-start: #0f766e; --theme-nav-end: #0891b2; }
body.theme-indigo { --theme-primary: #4338ca; --theme-primary-dark: #3730a3; --theme-primary-soft: #e0e3fb; --theme-primary-soft-2: #eef1ff; --theme-primary-soft-3: #e8ebff; --theme-accent-soft: #eef2ff; --theme-secondary: #4f46e5; --theme-nav-start: #4338ca; --theme-nav-end: #4f46e5; }
body.theme-amber { --theme-primary: #b45309; --theme-primary-dark: #92400e; --theme-primary-soft: #f6dfc5; --theme-primary-soft-2: #fff6eb; --theme-primary-soft-3: #fcebd7; --theme-accent-soft: #fff7ed; --theme-secondary: #a16207; --theme-nav-start: #b45309; --theme-nav-end: #d97706; }
body.theme-crimson { --theme-primary: #be123c; --theme-primary-dark: #9f1239; --theme-primary-soft: #f7d7df; --theme-primary-soft-2: #fff1f4; --theme-primary-soft-3: #fee7ee; --theme-accent-soft: #fff1f5; --theme-secondary: #9f1239; --theme-nav-start: #be123c; --theme-nav-end: #e11d48; }
body.theme-graphite { --theme-primary: #1f2937; --theme-primary-dark: #111827; --theme-primary-soft: #dbe0e7; --theme-primary-soft-2: #f3f5f8; --theme-primary-soft-3: #e8ecf2; --theme-accent-soft: #f9fafb; --theme-secondary: #374151; --theme-nav-start: #1f2937; --theme-nav-end: #4b5563; }
* { box-sizing: border-box; }
body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: var(--theme-bg); color: var(--theme-text); }
a { color: var(--theme-primary); text-decoration: none; }
button, .button-link { background: var(--theme-primary); color: #fff; border: 0; border-radius: 8px; padding: 10px 14px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; min-height: 42px; line-height: 1.2; font: inherit; text-decoration: none; vertical-align: middle; }
button:disabled { opacity: .6; cursor: not-allowed; }
.btn-small { padding: 6px 10px; font-size: 12px; }
.btn-danger { background: var(--theme-danger); }
.btn-secondary { background: var(--theme-secondary); }
.icon-only-button {
