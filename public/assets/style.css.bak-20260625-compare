.logout-form { margin: 0; }
.card { background: var(--theme-surface); border-radius: 16px; padding: 20px; margin-bottom: 20px; box-shadow: 0 8px 24px rgba(15, 76, 129, 0.08); }
.hero-card {
  padding: 22px 20px;
  border-radius: 20px;
  border: 1px solid #ebf1f7;
  background: linear-gradient(90deg, #f8fafc 0%, #f8fbfd 56%, var(--theme-accent-soft) 100%);
